{{!-- Available Mods --}}
<section>
    <div class="section-name section-name-mod">
        <h3>{{localize "SCRPG.mod.mod"}}</h3>
        <a title='{{localize "SCRPG.button.deleteMods" }}' class="delete-all" data-type="mod">
            <i class="fas fa-trash"></i>
        </a>
    </div>
    <div class="mods item-list">
        <table class="box-border">
            <tr>
                <th>{{localize "SCRPG.mod.addNew"}}</th>
                <th>{{localize "SCRPG.mod.bonus"}}</th>
                <th>{{localize "SCRPG.mod.penalty"}}</th>
            </tr>
            <tr>
                <td class="mod-create-td">
                    <div class="mod-name-row">
                        <label class="mod-name-label" for="{{actor._id}}-modName">{{localize "SCRPG.sheet.name"}}:</label>
                        <input id="{{actor._id}}-modName" name="system.modName" type="text" value="{{actor.system.modName}}"
                            placeholder='{{localize "SCRPG.mod.modName"}}' />
                    </div>
                    <div class="mod-dialogue">
                        <div class="mod-per-dialogue">
                            <p>
                                {{localize "SCRPG.mod.persistent"}}
                                <i title='{{localize "SCRPG.mod.persistent"}}' class="fas fa-hourglass"></i>
                            </p>
                            <input type="checkbox" name="system.persistent" {{checked actor.system.persistent}}
                                data-dtype="boolean" />
                        </div>
                        <div class="mod-exc-dialogue">
                            <p>
                                {{localize "SCRPG.mod.exclusive"}}
                                <i title='{{localize "SCRPG.mod.exclusive"}}' class="fas fa-lock"></i>
                            </p>
                            <input type="checkbox" name="system.exclusive" {{checked actor.system.exclusive}}
                                data-dtype="boolean" />
                        </div>
                    </div>
                    <div class="mod-value-radios" role="radiogroup" aria-label='{{localize "SCRPG.mod.value"}}'>
                        <label class="mod-value-option box-border green-abilities">
                            <input type="radio" name="system.modValue" value="+1" {{checked (eq actor.system.modValue "+1")}} />
                            <span>+1</span>
                        </label>
                        <label class="mod-value-option box-border green-abilities">
                            <input type="radio" name="system.modValue" value="+2" {{checked (eq actor.system.modValue "+2")}} />
                            <span>+2</span>
                        </label>
                        <label class="mod-value-option box-border green-abilities">
                            <input type="radio" name="system.modValue" value="+3" {{checked (eq actor.system.modValue "+3")}} />
                            <span>+3</span>
                        </label>
                        <label class="mod-value-option box-border green-abilities">
                            <input type="radio" name="system.modValue" value="+4" {{checked (eq actor.system.modValue "+4")}} />
                            <span>+4</span>
                        </label>
                        <label class="mod-value-option box-border red-abilities">
                            <input type="radio" name="system.modValue" value="-1" {{checked (eq actor.system.modValue "-1")}} />
                            <span>-1</span>
                        </label>
                        <label class="mod-value-option box-border red-abilities">
                            <input type="radio" name="system.modValue" value="-2" {{checked (eq actor.system.modValue "-2")}} />
                            <span>-2</span>
                        </label>
                        <label class="mod-value-option box-border red-abilities">
                            <input type="radio" name="system.modValue" value="-3" {{checked (eq actor.system.modValue "-3")}} />
                            <span>-3</span>
                        </label>
                        <label class="mod-value-option box-border red-abilities">
                            <input type="radio" name="system.modValue" value="-4" {{checked (eq actor.system.modValue "-4")}} />
                            <span>-4</span>
                        </label>
                    </div>
                    <div class="mod-actions">
                        <button type="button" class="create-mod box-border" data-type="mod">
                            {{localize "SCRPG.button.applyToMe"}}
                        </button>
                        <button type="button" class="send-mod-chat box-border" data-type="mod">
                            {{localize "SCRPG.button.sendToChat"}}
                        </button>
                    </div>
                </td>
                <td class="mod-drop-target" data-mod-list="bonus">
                    <div class="bonuses">
                        {{#each actor.mod as |mod id|}}
                        {{#if (gte system.value 0)}}
                        <div class="mod-item item mod-select box-border green-abilities {{#if (eq system.selected true)}}green-border{{/if}}"
                            data-item-id="{{ mod._id}}">
                            <h3>{{#if (eq system.named true)}}{{name}}{{/if}} {{system.value}}</h3>
                            <div class="p-e-icon">
                                {{#if (eq system.persistent true)}}
                                <i title='{{localize "SCRPG.mod.persistent"}}' class="fas fa-hourglass"></i>
                                {{/if}}
                                {{#if (eq system.exclusive true)}}
                                <i title='{{localize "SCRPG.mod.exclusive"}}' class="fas fa-lock"></i>
                                {{/if}}
                            </div>
                        </div>
                        {{/if}}
                        {{/each}}
                    </div>
                </td>
                <td class="mod-drop-target" data-mod-list="penalty">
                    <div class="penalties">
                        {{#each actor.mod as |mod id|}}
                        {{#if (lte system.value 0)}}
                        <div class="mod-item item mod-select box-border red-abilities  {{#if (eq system.selected true)}}red-border{{/if}}"
                            data-item-id="{{ mod._id}}">
                            <h3>{{#if (eq system.named true)}}{{name}}{{/if}} {{system.value}}</h3>
                            <div class="p-e-icon">
                                {{#if (eq system.persistent true)}}
                                <i title='{{localize "SCRPG.mod.persistent"}}' class="fas fa-hourglass"></i>
                                {{/if}}
                                {{#if (eq system.exclusive true)}}
                                <i title='{{localize "SCRPG.mod.exclusive"}}' class="fas fa-lock"></i>
                                {{/if}}
                            </div>
                        </div>
                        {{/if}}
                        {{/each}}
                    </div>
                </td>
            </tr>
        </table>
    </div>
</section>
