<div class="sheet-content-root scroll-root {{cssClass}}">
<div class="minion-count">
        <h3 style="padding-right: 4px;">{{localize "SCRPG.sheet.group"}}:</h3>

        <select name="system.groups">
            <option value="1" {{#if (eq actor.system.groups "1")}}selected{{/if}}>{{actor.system.groupName.one}}</option>
            <option value="2" {{#if (eq actor.system.groups "2")}}selected{{/if}}>{{actor.system.groupName.two}}</option>
            <option value="3" {{#if (eq actor.system.groups "3")}}selected{{/if}}>{{actor.system.groupName.three}}</option>
            <option value="4" {{#if (eq actor.system.groups "4")}}selected{{/if}}>{{actor.system.groupName.four}}</option>
            <option value="5" {{#if (eq actor.system.groups "5")}}selected{{/if}}>{{actor.system.groupName.five}}</option>
            <option value="6" {{#if (eq actor.system.groups "6")}}selected{{/if}}>{{actor.system.groupName.six}}</option>
            <option value="7" {{#if (eq actor.system.groups "7")}}selected{{/if}}>{{actor.system.groupName.seven}}</option>
            <option value="8" {{#if (eq actor.system.groups "8")}}selected{{/if}}>{{actor.system.groupName.eight}}</option>
            <option value="9" {{#if (eq actor.system.groups "9")}}selected{{/if}}>{{actor.system.groupName.nine}}</option>
            <option value="10" {{#if (eq actor.system.groups "10")}}selected{{/if}}>{{actor.system.groupName.ten}}</option>
        </select>
    </div>

    {{#if activeMinionGroup.showDivider}}
    <div class="line-1"></div>
    {{/if}}
    <div class="box-border minion-group-name">
        <h3>
            <input class="minion-group-name-input" type="text" name="{{activeMinionGroup.nameField}}"
                value="{{activeMinionGroup.name}}" placeholder='{{localize "SCRPG.minion.minionlieutenant"}}'>
        </h3>
        <select class="minion-role-select" name="system.role" title='{{localize "SCRPG.minion.role.label"}}'>
            {{selectOptions config.minionRoles selected=actor.system.role localize=true}}
        </select>
        <select name="{{activeMinionGroup.dieField}}">
            {{selectOptions config.dieTypes selected=activeMinionGroup.die localize=true}}
        </select>
        <a title='{{localize "SCRPG.button.addNew" }}' class="item-create minion-group-item" data-type="heroMinion"
            data-group={{activeMinionGroup.index}} data-dietype={{activeMinionGroup.die}}>
            <i class="fas fa-plus"></i>
        </a>
        {{> "systems/scrpg-foundry/templates/partials/minionsheetbuttons.hbs" index=activeMinionGroup.index}}
    </div>

    <div class="minion-desc-tactics">
        <div class="minion-desc-tactics-col box-border">
            <h3>{{localize "SCRPG.minion.description"}}</h3>
            <textarea name="system.description" rows="5">{{actor.system.description}}</textarea>
        </div>
        <div class="minion-desc-tactics-col box-border">
            <h3>{{localize "SCRPG.minion.tactics"}}</h3>
            <textarea name="system.tactics" rows="5">{{actor.system.tactics}}</textarea>
        </div>
    </div>

    {{> "systems/scrpg-foundry/templates/partials/miniongroups.hbs" index=activeMinionGroup.index}}

</div>
